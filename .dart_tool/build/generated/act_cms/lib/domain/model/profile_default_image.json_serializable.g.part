ProfileDefaultImage _$ProfileDefaultImageFromJson(Map<String, dynamic> json) =>
    ProfileDefaultImage(
      id: (json['id'] as num).toInt(),
      url: json['url'] as String,
    );

Map<String, dynamic> _$ProfileDefaultImageToJson(
        ProfileDefaultImage instance) =>
    <String, dynamic>{
      'id': instance.id,
      'url': instance.url,
    };
